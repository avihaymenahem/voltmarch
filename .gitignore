# dependencies
node_modules/

# build output
dist/
dist-ssr/
*.tsbuildinfo

# screenshot harness output (regenerated by `npm run shots`)
shots/

# Edge-detection output from `tools/sobel.mjs`. Regenerated on demand and 43 MB
# a run — the kind of thing that is committed once and then lives in the history
# forever.
shots-sobel/

# `tools/flash-stack.mjs` output — one PNG per ablation arm per count, per tag.
.flash-stack/

# `node tools/audio-measure.mjs --wav` output — one WAV per sound family so a human
# can judge the synthesis by ear. WRITE-ONLY: nothing in the repo ever reads them back
# (`WAV_DIR` in that script is only ever passed to `writeFileSync`). They were tracked
# until 2026-08-07, 5.6 MB of it, and `music.idle.wav` is in the history TWICE as two
# distinct 1.5 MB blobs because a regenerated dump got committed a second time. That is
# the exact failure mode the `shots-sobel/` comment above warns about.
docs/audio/

# `tools/crop-surfaces.mjs` output — the post-overhaul half of the texture
# before/after, cropped out of `shots/`. Regenerable: `npm run shots`, then the
# tool. Its `ours-*` counterpart stays TRACKED and must not be added here — that
# half predates the overhaul and nothing can regenerate it.
docs/surface-refs/after-*.png

# Throwaway diagnostic probes. The convention is a leading underscore: a tool
# written to answer one question during one investigation, kept locally until it
# is answered and not worth a reviewer's attention. Anything durable earns a
# real name and gets committed.
tools/_*

# Third-party reference screenshots used for art direction.
#
# These are copyrighted frames from other companies' games (Red Alert 2/3 and
# the C&C Remastered Collection - EA; Company of Heroes 3 - Relic; Age of
# Empires IV - Microsoft; Homeworld 3 - Gearbox; Tempest Rising - Slipgate).
# Studying them to derive an art direction is ordinary practice; redistributing
# them from a public repository is not, so they stay local. Nothing in the build
# depends on them - they are inputs to the visual-critique tooling only.
#
# To recreate the set, see docs/RA3_LOOK_BIBLE.md for what was sampled, and
# tools/ for the harness that consumes it.
refs/
docs/surface-refs/ra3-*

# vite / vitest caches
.vite/
node_modules/.vite/
coverage/

# editors & OS
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
.DS_Store
Thumbs.db

# local env
*.local
.env
.env.*
!.env.example

# logs
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/
*.log
.shots-staging/
