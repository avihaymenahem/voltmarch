{
  "name": "@voltmarch/game",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.test.json",
    "test": "cd ../.. && vitest run --config apps/game/vite.config.ts",
    "test:sim": "node scripts/test-scope.mjs sim",
    "test:render": "node scripts/test-scope.mjs render",
    "test:ui": "node scripts/test-scope.mjs ui",
    "test:assets": "node scripts/test-scope.mjs assets",
    "test:contracts": "node scripts/test-scope.mjs contracts",
    "soak": "cd ../.. && vitest run --config apps/game/vite.config.ts -t determinism"
  },
  "dependencies": {
    "@voltmarch/game-types": "*",
    "@voltmarch/protocol": "*",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/three": "^0.185.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  },
  "engines": {"node": ">=20.19.0"}
}
