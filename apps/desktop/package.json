{
  "name": "@voltmarch/desktop",
  "private": true,
  "license": "UNLICENSED",
  "author": {
    "name": "Avihay Menahem"
  },
  "description": "VOLTMARCH desktop shell. Wraps the shared game client in Electron so the discrete GPU can be enforced and a match survives alt-tab.",
  "main": "out/main.js",
  "scripts": {
    "build": "node build.mjs",
    "start": "npm run build && electron .",
    "dist": "npm run build && node dist.mjs",
    "dev": "node dev.mjs",
    "preview": "node preview.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "cd ../.. && vitest run --config apps/desktop/vitest.config.ts",
    "test:diagnostics-smoke": "npm run build && node diagnostics-smoke.mjs",
    "test:contracts": "npm test"
  },
  "devDependencies": {
    "electron": "43.4.1",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.25.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
