{
  "name": "@voltmarch/protocol",
  "private": true,
  "license": "UNLICENSED",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "src/index.ts",
  "typesVersions": {
    "*": {
      "turn-relay": ["src/TurnRelay.ts"],
      "*": ["src/index.ts"]
    }
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./dist/index.js"
    },
    "./turn-relay": {
      "types": "./src/TurnRelay.ts",
      "import": "./src/TurnRelay.ts",
      "require": "./dist/TurnRelay.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.spec.cjs",
    "test:contracts": "npm test"
  },
  "dependencies": {
    "@voltmarch/game-types": "*"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
