# ============================================================================
# voltmarch-relay.service — systemd unit for the lockstep relay
# ============================================================================
# Install:
#   sudo useradd --system --no-create-home --shell /usr/sbin/nologin voltmarch
#   sudo mkdir -p /opt/voltmarch-relay && sudo chown voltmarch: /opt/voltmarch-relay
#   # copy server/dist, server/package.json, server/package-lock.json there, then:
#   sudo -u voltmarch npm --prefix /opt/voltmarch-relay ci --omit=dev
#   sudo cp voltmarch-relay.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now voltmarch-relay
#
# The relay binds 127.0.0.1 ONLY. nginx terminates TLS and is the sole route in
# — see nginx.conf. Do not open 8787 on the firewall.
# ============================================================================

[Unit]
Description=VOLTMARCH lockstep relay
# `network.target`, not `network-online.target`. The relay binds an IP LITERAL
# on loopback, so it needs no address to have been configured and no name to
# resolve; waiting for the online target only delays boot.
After=network.target

# IN [Unit], NOT [Service]. systemd moved both of these in v229; `StartLimitBurst`
# survives in [Service] as a compatibility alias but `StartLimitIntervalSec` does
# NOT, so the interval was being ignored and only the default 10 s applied. The
# guarantee happened to survive (RestartSec=2 against a 10 s window still trips
# at five starts) but it survived by accident. `systemd-analyze verify` on the
# target box is the instrument that settles this.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=voltmarch
Group=voltmarch
WorkingDirectory=/opt/voltmarch-relay

# --disallow-code-generation-from-strings kills eval() and new Function()
# process-wide. Neither `ws` nor this server needs them, so the capability is
# simply removed rather than trusted not to be reached.
ExecStart=/usr/bin/node --disallow-code-generation-from-strings dist/server/src/index.js

Environment=NODE_ENV=production
Environment=VM_HOST=127.0.0.1
Environment=VM_PORT=8787

# WITHOUT THIS, EVERY PER-ADDRESS LIMIT IN THE RELAY IS GLOBAL.
#
# nginx terminates TLS and proxies to loopback, so every socket arrives from
# 127.0.0.1 and `remoteAddress` is the same value for the entire internet: the
# 8-connections-per-address cap becomes a global cap of 8, and the
# 10-joins-per-minute limit becomes 10 joins per minute for ALL players
# combined. The counters look busy and protect nobody.
#
# This lists the peers whose `X-Real-IP` is believed. It must contain ONLY the
# proxy — a forwarded header is a client-supplied string, and trusting one from
# a direct connection lets anyone mint a fresh identity per request.
Environment=VM_TRUSTED_PROXIES=127.0.0.1,::1,::ffff:127.0.0.1
# The origin the game is actually served from.
#
# THIS REPLACES THE COMPILED DEFAULT LIST, IT DOES NOT EXTEND IT. Measured: with
# this line as written, `http://localhost:5173` — which IS in `config.ts`'s
# fallback array — is answered 401. So whatever is listed here is the complete
# browser allowlist, and a wrong one rejects your own players. Comma-separated.
#
# The DESKTOP build's origin (`app://voltmarch`) does not belong here and must
# not be added: `config.ts` unions it in unconditionally, precisely because this
# variable replaces the list and an entry that lived only in the fallback would
# vanish the moment an operator set this. `app:` is not a scheme any browser can
# mint, so allowing it costs nothing.
Environment=VM_ORIGINS=https://avihaymenahem.github.io
# Set to the deployed client version to refuse mismatched builds outright.
# Leave unset only while testing — two builds of a deterministic simulation
# desync on contact, and refusing the pairing is far kinder than a desync.
#
# THE EXAMPLE MUST TRACK `package.json`. It read 1.33.0 for three major versions
# and uncommenting it as written would have refused every real client, which is
# a self-inflicted outage on the first deploy. Read the version, do not copy it.
#Environment=VM_REQUIRE_BUILD=3.0.2

# A crash loop must not become a busy loop — see StartLimit* in [Unit] above.
Restart=always
RestartSec=2

# -- sandbox ---------------------------------------------------------------
# The relay reads no files, writes no files, and talks to nothing but its
# socket. Everything below removes a capability it never had a use for, so a
# remote-code-execution bug in a dependency has nowhere to go.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_INET AF_INET6
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @obsolete
# WITHOUT THIS A FILTERED SYSCALL IS SIGSYS: the process dies with no message
# and systemd reports a signal, not a reason. `~@resources` denies `setrlimit`
# and `sched_setaffinity`, which node and V8 do touch at startup on some
# builds — so this is the difference between a diagnosable EPERM and a silent
# crash loop on a box nobody here owns.
SystemCallErrorNumber=EPERM
# Pairs with ProtectProc=invisible: /proc holds only this process's own pids.
ProcSubset=pid
RemoveIPC=yes
UMask=0077

# THE NETWORK HALF OF THE SANDBOX, which was entirely missing while the comment
# above promised an RCE "has nowhere to go". The relay makes ZERO outbound
# connections — it binds an IP literal, so node never even calls getaddrinfo —
# so denying everything but loopback costs nothing and inbound from nginx on
# 127.0.0.1 still passes. journald's socket is AF_UNIX and unaffected.
#
# IF YOU EVER SET VM_HOST TO A PUBLIC ADDRESS, THIS BREAKS THE SERVICE. That is
# the correct trade for this deployment (the relay must not be routable) but it
# is a trap worth knowing about before you change the bind address.
IPAddressDeny=any
IPAddressAllow=localhost

# `User=` plus `NoNewPrivileges=` already means this process holds no
# capabilities. Stating the empty set costs nothing and makes that explicit to
# `systemd-analyze security`, which is the right instrument for auditing all of
# the above on the target box.
CapabilityBoundingSet=
AmbientCapabilities=

# MemoryDenyWriteExecute MUST STAY OFF.
# V8 is a JIT: it writes machine code and then executes it, which is exactly
# what this flag forbids. Turning it on does not harden the service, it stops
# node from starting at all. This line exists so nobody "completes" the sandbox
# above by adding it and then spends an evening on the crash.
MemoryDenyWriteExecute=no

# -- resources -------------------------------------------------------------
# A hard ceiling under the process, beneath the application's own caps in
# config.ts. If those ever fail, this is what stops one relay taking the box.
MemoryMax=512M
TasksMax=64
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
