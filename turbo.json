{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "stream",
  "globalDependencies": ["package-lock.json", "LICENSE", "THIRD_PARTY_NOTICES.md"],
  "tasks": {
    "build": {"dependsOn": ["^build"], "outputs": ["dist/**", "out/**"]},
    "typecheck": {"dependsOn": ["^typecheck"], "outputs": []},
    "test": {"dependsOn": ["^build"], "outputs": []},
    "test:sim": {"dependsOn": ["^build"], "outputs": []},
    "test:render": {"dependsOn": ["^build"], "outputs": []},
    "test:ui": {"dependsOn": ["^build"], "outputs": []},
    "test:assets": {"dependsOn": ["^build"], "outputs": []},
    "test:contracts": {"dependsOn": ["^build"], "outputs": []},
    "dev": {"cache": false, "persistent": true},
    "dist": {"dependsOn": ["@voltmarch/game#build", "build"], "cache": false}
  }
}
